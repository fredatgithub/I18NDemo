<Window x:Class="I18NDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:I18NDemo"
        mc:Ignorable="d"
        Title="i18n Demo" Height="450" Width="800" WindowStartupLocation="CenterScreen">

  <Grid Margin="25">

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Choix de la langue -->
    <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

      <TextBlock Text="{Binding [Language],
                      Source={x:Static local:LocalizationManager.Instance}}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

      <ComboBox x:Name="CmbLanguage"
                      Width="120"
                      SelectedIndex="0"
                      SelectionChanged="CmbLanguage_SelectionChanged">

        <ComboBoxItem Content="Français" Tag="fr"/>
        <ComboBoxItem Content="English" Tag="en"/>

      </ComboBox>

    </StackPanel>

    <!-- Bienvenue -->
    <TextBlock Grid.Row="1"
                   Text="{Binding [Welcome],
                   Source={x:Static local:LocalizationManager.Instance}}"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,35,0,10"/>

    <!-- Description -->
    <TextBlock Grid.Row="2"
                   Text="{Binding [Description],
                   Source={x:Static local:LocalizationManager.Instance}}"
                   FontSize="14"/>

    <!-- Date -->
    <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

      <TextBlock Text="{Binding [CurrentDate],
                      Source={x:Static local:LocalizationManager.Instance}}"
                       FontWeight="Bold"
                       Margin="0,0,10,0"/>

      <TextBlock Text="{Binding CurrentDateText,
                      Source={x:Static local:LocalizationManager.Instance}}"/>

    </StackPanel>

    <!-- Boutons -->
    <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

      <Button Content="{Binding [ButtonValidate],
                     Source={x:Static local:LocalizationManager.Instance}}"
                    Width="100"
                    Height="35"
                    Margin="5"/>

      <Button Content="{Binding [ButtonCancel],
                     Source={x:Static local:LocalizationManager.Instance}}"
                    Width="100"
                    Height="35"
                    Margin="5"/>

    </StackPanel>

  </Grid>
</Window>
